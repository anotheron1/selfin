#!/bin/sh
# Копия обеих баз (шаг 5 плана спринта 6, спека docs/superpowers/specs/2026-10-18-backups-design.md).
# Сначала наша база, потом Keycloak — одна точка восстановления: учётная запись Keycloak появляется раньше нашей
# строки. Каждый файл шифруется открытым ключом владельца потоком — открытого текста на диске нет. Потом выгрузка во
# внешнее хранилище, уборка старых копий и отметка об успехе. Упала любая команда — копии нет, отметки нет.
set -eu -o pipefail

stamp=$(date -u +%Y-%m-%dT%H%MZ)
dir="/backups/$stamp"
mkdir -p "$dir"
enc() { age -r "$SELFIN_BACKUP_AGE_RECIPIENT" -o "$dir/$1.age"; }
ours() { PGPASSWORD="$POSTGRES_PASSWORD" "$@" -h db -U admin -d selfin; }
keycloak() { PGPASSWORD="$KC_DB_PASSWORD" "$@" -h keycloak-db -U keycloak -d keycloak; }

ours pg_dump --clean --if-exists | enc selfin.sql
keycloak pg_dump --clean --if-exists | enc keycloak.sql
# ponytail: манифест — отдельным снимком после дампа; запись между ними даст расхождение в проверке. В 03:30 писать
# некому; станет мешать — дамп и манифест из одного снимка (pg_export_snapshot).
{
  printf 'backend %s\n' "$(curl -fsS -m 10 http://backend:8080/api/v1/version || echo unknown)"
  ours psql -XAtq -v ON_ERROR_STOP=1 -f /usr/local/share/selfin/manifest.sql
} | enc manifest.txt

rclone copy "$dir" "store:$SELFIN_BACKUP_BUCKET/$stamp"
# Сроки — не настройка: в хранилище 30 дней, потому что тексты обещают удаление данных в течение 30 дней, и из копий
# удалённый уходит вместе с самой старой из них; на сервере — 7, на случай без хранилища.
find /backups -mindepth 1 -maxdepth 1 -type d -mtime +7 -exec rm -rf {} +
rclone delete --min-age 30d --rmdirs "store:$SELFIN_BACKUP_BUCKET"
[ -z "${SELFIN_BACKUP_PING_URL:-}" ] || curl -fsS -m 10 --retry 3 -o /dev/null "$SELFIN_BACKUP_PING_URL"
echo "копия $stamp: обе базы и манифест выгружены"
