# Шаблон .env сервера selfin (deploy/docker-compose.yml). Скопировать в .env и заполнить; .env — в .gitignore.
# Пароли — длинные случайные, без кавычек. В репозиторий, спеки, Linear и чат значения не попадают.

# Адрес сервера: имя для сертификата Caddy и полный публичный адрес (на нём Keycloak строит адрес возврата из Telegram).
SELFIN_DOMAIN=
SELFIN_PUBLIC_URL=

# Какой образ тянуть из GHCR: latest или sha-<коммит>.
SELFIN_TAG=latest

# База приложения: владелец таблиц (миграции) и роль приложения selfin_app.
POSTGRES_PASSWORD=
SELFIN_DB_APP_PASSWORD=

# Keycloak: своя база и администратор.
KC_DB_PASSWORD=
KC_ADMIN_PASSWORD=

# POSTGRES_PASSWORD и KC_DB_PASSWORD Postgres берёт только при первом создании базы, KC_ADMIN_PASSWORD Keycloak — только
# при первом старте. Поменяешь здесь позже — базы останутся со старыми паролями, а приложение и Keycloak станут входить
# с новыми и перезапускаться без конца. Порядок смены — сначала в базе, потом здесь, потом docker compose up -d:
#   docker compose exec db psql -U admin -d selfin -c '\password admin'                   — POSTGRES_PASSWORD
#   docker compose exec keycloak-db psql -U keycloak -d keycloak -c '\password keycloak'   — KC_DB_PASSWORD
# Новый пароль psql спросит с клавиатуры, в историю команд он не попадёт. KC_ADMIN_PASSWORD — в консоли администратора
# (реалм master → Users → admin → Credentials). SELFIN_DB_APP_PASSWORD меняется прямо здесь: роли его ставит приложение
# при каждом старте.

# Секрет клиента selfin — один у Keycloak и у нашего сервера.
SELFIN_CLIENT_SECRET=

# Бот Telegram для сервера: @BotFather → Login Widget → Switch to OpenID Connect Login.
# В Allowed URLs — SELFIN_PUBLIC_URL и адрес возврата <SELFIN_PUBLIC_URL>/auth/realms/selfin/broker/telegram/endpoint.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# SELFIN_PUBLIC_URL, SELFIN_CLIENT_SECRET и TELEGRAM_* Keycloak берёт отсюда, а реалм — из репозитория только при первом
# старте: дальше реалм уже есть, и импорт его пропускает. Поменять потом:
# * пока людей нет (до шага 7) — пересоздать Keycloak вместе с его базой:
#     docker compose rm -sf keycloak keycloak-db && docker volume rm selfin-server_keycloak_data && docker compose up -d
# * когда люди есть — в консоли администратора (туннель к 127.0.0.1:8180), потом то же значение сюда. Пересоздавать
#   Keycloak тогда нельзя: у каждого человека появится новый sub, а его данные останутся у старого.

# Кому достаются нынешние данные — sub владельца в реалме ЭТОГО сервера. Ставится в шаге 7, строго по порядку
# из комментария 17.10 в ANO-197: сначала вход только в Keycloak, потом этот sub, потом вход в приложение.
SELFIN_OWNER_SUB=

# Порты — если у сервера 80 и 443 заняты; консоль администратора Keycloak — только на 127.0.0.1.
# Сертификат Let's Encrypt Caddy получит, только если до него снаружи доходит 80 или 443: на других портах — за чужим прокси (шаг 6).
# SELFIN_HTTP_PORT=80
# SELFIN_HTTPS_PORT=443
# SELFIN_KC_ADMIN_PORT=8180
