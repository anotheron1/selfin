{
  "realm": "selfin",
  "displayName": "Selfin",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "selfin",
      "name": "Selfin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${SELFIN_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5173/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak",
        "http://127.0.0.1:5174/login/oauth2/code/keycloak",
        "http://localhost:5174/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/login##http://localhost:5173/login##http://127.0.0.1:5174/login##http://localhost:5174/login"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile"
      ],
      "optionalClientScopes": []
    }
  ],
  "identityProviders": [
    {
      "alias": "telegram",
      "displayName": "Telegram",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "https://oauth.telegram.org",
        "authorizationUrl": "https://oauth.telegram.org/auth",
        "tokenUrl": "https://oauth.telegram.org/token",
        "jwksUrl": "https://oauth.telegram.org/.well-known/jwks.json",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "${TELEGRAM_CLIENT_ID}",
        "clientSecret": "${TELEGRAM_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_basic",
        "defaultScope": "openid profile",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "disableUserInfo": "true",
        "syncMode": "IMPORT"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
