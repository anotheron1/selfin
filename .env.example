# Шаблон .env для стенда (docker-compose.test.yml). Скопировать в .env и заполнить; .env — в .gitignore.

# Вход через Telegram (ANO-143): мини-приложение @BotFather → бот → Login Widget → Switch to OpenID Connect Login.
# В Redirect URIs (раньше — Allowed URLs) — http://127.0.0.1:8180 и адрес возврата http://127.0.0.1:8180/realms/selfin/broker/telegram/endpoint
# (localhost BotFather не принимает); там же — Client ID и Client Secret. Токен бота для входа не нужен.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Пароль администратора Keycloak на стенде; без него — admin.
KC_ADMIN_PASSWORD=

# Адрес Keycloak, если стенд открывают не с 127.0.0.1 (туннель, домен); без него — http://127.0.0.1:8180.
# Адрес возврата в Redirect URIs бота строится от него.
KC_HOSTNAME=

# Секрет клиента selfin — один у Keycloak и у нашего сервера (ANO-195); без него — selfin-dev-secret.
SELFIN_CLIENT_SECRET=

# Кому достаются нынешние данные (ANO-195): sub учётной записи Keycloak. Сервер связывает его с владельцем
# данных при первом входе, один раз. На стенде — тестовый человек tester (решение владельца 14.10): его же
# паролем ходят скрипты, и с RLS (ANO-144) они видят те же данные. Его sub — node tools/keycloak-token.mjs --sub
SELFIN_OWNER_SUB=
