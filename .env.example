# Шаблон .env для стенда (docker-compose.test.yml). Скопировать в .env и заполнить; .env — в .gitignore.

# Вход через Telegram (ANO-143): @BotFather → бот → Login Widget. В Allowed URLs — адрес возврата
# http://localhost:8180/realms/selfin/broker/telegram/endpoint; там же — Client ID и Client Secret.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Пароль администратора Keycloak на стенде; без него — admin.
KC_ADMIN_PASSWORD=

# Адрес Keycloak, если стенд открывают не с localhost (туннель, домен); без него — http://localhost:8180.
# Адрес возврата в Allowed URLs бота строится от него.
KC_HOSTNAME=
